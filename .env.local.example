# Copy to .env.local and fill in. .env.local is gitignored.
#
# Zerops personal access token — app.zerops.io -> avatar -> Access Token
# Management. Must be a PERSONAL token: it needs to create and delete projects,
# which integration tokens are scoped away from.
ZEROPS_TOKEN=

# Optional overrides
# OPENTRY_WARM_PER_APP=1
# OPENTRY_MAX_CONCURRENT_TRIALS=6
# DATABASE_URL=postgresql://user:pass@localhost:5432/opentry
